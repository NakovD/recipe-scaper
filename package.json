{
  "name": "recipe-scraper",
  "version": "1.0.0",
  "description": "Local scraper and browser for a recipe website (configured via .env)",
  "type": "module",
  "scripts": {
    "scrape": "tsx scraper.ts",
    "build:frontend": "tsx generateDomainConfig.ts && tsc -p tsconfig.frontend.json",
    "serve": "npm run build:frontend && tsx server.ts",
    "bundle:server": "npm run build:frontend && esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-pkg/server.cjs",
    "package:win": "npm run bundle:server && pkg dist-pkg/server.cjs --sea --output dist-pkg/recipe-browser.exe",
    "dist": "npm run package:win && tsx prepareDist.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^25.9.3",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "fastify": "^5.10.0",
    "fuse.js": "^7.5.0",
    "playwright": "^1.61.0"
  }
}
